# Host ports of the GTA Compose stack (read automatically by docker compose,
# because this file sits next to compose.bd.rstudio.newversiongeoflow.yml).
# Uncommon ports, bound to 127.0.0.1 only. Containers keep their usual ports
# inside the Docker network (postgres:5432, geoserver:8080…).
# A variable set in your shell takes precedence over this file.
# No secrets here: this file is versioned.
GTA_PG_PORT=15430
GTA_GEOSERVER_PORT=18080
GTA_GEONETWORK_PORT=18081
GTA_RSTUDIO_PORT=18787
GTA_SHINY_PORT=13838
