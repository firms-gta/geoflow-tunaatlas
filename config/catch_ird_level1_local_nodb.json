{
  "profile": {
    "id": "tuna-atlas-catch",
    "mode": "entity",
    "project": "FIRMS Tuna Atlas",
    "organization": "FIRMS Tuna Atlas",
    "logos": [
      "http://firms.fao.org/figis/website/assets/images/templates/firms/firms_banner.gif",
      "https://www.blue-cloud.org/sites/default/files/styles/logo_small/public/FAO_2lines_500x500_1.png?itok=igwPSL5v",
      "https://en.ird.fr/sites/ird_fr/files/2019-08/logo_IRD_2016_BLOC_UK_COUL.png"
    ],
    "options": {
      "line_separator": "_\n"
    }
  },
  "metadata": {
    "entities": [
      {
        "handler": "csv",
        "source": "config/geoflow_entities_tuna_global_datasets_ird_level1 - 2026_worfklow_catch_level1.csv"
      }
    ],
    "contacts": []
  },
  "software": [],
  "actions": [
    {
      "id": "load_dataset",
      "script": "../R/tunaatlas_actions/load_dataset.R",
      "run": true,
      "options": {
        "upload_to_db_public": false,
        "upload_to_db": false,
        "create_materialized_view": false,
        "add_sql_comments": false,
        "upload_to_googledrive": false,
        "save_local_path": "../../../../data/GTA_2026/dataoutputGTA/",
        "save_local_overwrite": true
      }
    },
    {
      "id": "enrich_metadata",
      "script": "../R/tunaatlas_actions/enrich_metadata.R",
      "run": true
    },
    {
      "id": "enrich_for_db_services",
      "script": "../R/tunaatlas_actions/enrich_db_for_services.R",
      "run": true
    },
    {
      "id": "load_metadata",
      "script": "../R/tunaatlas_actions/load_metadata.R",
      "run": true
    },
    {
      "id": "geometa-create-iso-19115",
      "run": true,
      "options": {
        "doi": true,
        "logo": true,
        "upload_to_db": false,
        "upload_to_db_public": false,
        "create_materialized_view": false,
        "add_sql_comments": false
      }
    },
    {
      "id": "geometa-create-iso-19110",
      "run": true,
      "options": {
        "exclude_attributes": [
          "time_start",
          "time_end"
        ],
        "exclude_values_for_attributes": [
          "geographic_identifier",
          "measurement"
        ],
        "extra_attributes": [
          "geom",
          "aggregation_method"
        ],
        "upload_to_db": false,
        "upload_to_db_public": false,
        "create_materialized_view": false,
        "add_sql_comments": false
      }
    }
  ]
