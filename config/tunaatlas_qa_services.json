{
  "profile": {
    "id": "tuna-atlas-services",
    "mode": "entity",
    "environment": {
  		"file": "zenodo_secrets.env",
  		"hide_env_vars": ["USER", "PASSWORD", "TOKEN"]
  	},
    "project": "FIRMS Tuna Atlas",
    "organization": "FIRMS Tuna Atlas",
    "logos": [],
    "options": {
      "line_separator": "_\n"
    }
  },
  "metadata": {
    "dictionary": {
      "handler": "csv",
      "source": "data/geoflow_tuna_dictionary.csv"
    },
    "entities": {
      "handler": "dbi",
      "source": "SELECT * FROM metadata.metadata_dcmi"
    },
    "contacts": {
      "handler": "csv",
      "source": "data/geoflow_tuna_contacts.csv"
    }
  },
  "software": [    
    {
  		"id": "my-zenodo",
		  "type": "output",
		  "software_type": "zenodo",
		  "parameters": {
    		"url": "{{ ZENODO_URL }}",
    		"token": "{{ ZENODO_TOKEN }}",
    		"logger": "DEBUG"
		  }
		},

{
		"id": "tunaatlas-db-write",
		"type": "output",
		"software_type": "dbi",
		"parameters": {
			"drv": "PostgreSQL",
			"user": "{{DB_USER}}",
			"password": "{{DB_PASSWORD}}",
			"host": "{{DB_HOST}}",
			"port": "{{DB_PORT}}",
			"dbname": "{{DB_NAME}}"
		},
		"properties" : {
		}
	},
	{
		"id": "tunaatlas-db-read",
		"type": "input",
		"software_type": "dbi",
		"parameters": {
			"drv": "PostgreSQL",
			"user": "{{DB_USER}}",
			"password": "{{DB_PASSWORD}}",
			"host": "{{DB_HOST}}",
			"port": "{{DB_PORT}}",
			"dbname": "{{DB_NAME}}"
		},
		"properties" : {
		}
	},
	{
		"id": "my-geonetwork",
		"type": "output",
		"software_type": "geonetwork",
		"parameters": {
			"url": "{{GEONETWORK_URL}}",
			"user": "{{GEONETWORK_USER}}",
			"pwd": "{{GEONETWORK_PASSWORD}}",
			"version": "{{GEONETWORK_VERSION}}",
			"logger": "DEBUG"
		}
	},
	{
		"id": "my-geoserver",
		"type": "output",
		"software_type": "geoserver",
		"parameters": {
			"url": "{{GEOSERVER_URL}}",
			"user": "{{GEOSERVER_USER}}",
			"pwd": "{{GEOSERVER_PASSWORD}}",
			"logger": "DEBUG"
		},
		"properties" : {
			"workspace": "{{GEOSERVER_WORKSPACE}}",
			"store": "{{GEOSERVER_STORE}}"
		}
	}
  ],
  "actions": [
  	{
      "id": "geometa-create-iso-19115",
      "run": true,
  	  "options": {
    		"logo": true,
    		"doi": true,
    		"doi_thumbnail": false,
    		"addfeatures": false
      }
	},
  	{
  	  "id": "geometa-create-iso-19110",
  	  "run": true,
  	  "options" : {
		  "exclude_attributes": ["time_start", "time_end"],
		  "exclude_values_for_attributes": ["geographic_identifier", "measurement"],
		  "extra_attributes": ["geom","aggregation_method"]
  	  }
  	},
  	{
  	  "id": "geonapi-publish-iso-19139",
  	  "run": true
  	},
  		{
		"id": "geosapi-publish-ogc-services",
		"run":true,
		"options": {
		  "createWorkspace": true,
		  "createStore": true,
		  "overwrite": true,
		  "describe_wms_relation_with_category": false,
		  "describe_wms_relation_with_ogc_service_description" : false
		}
		},
  	{
      "id": "zen4R-deposit-record",
      "run": true,
      "options": {
        "update_files": true,
        "depositWithFiles": true,
        "communities": "",
        "deleteOldFiles": true,
        "update_metadata": true,
        "strategy": "newversion",
        "publish": true
      }
  	}
	
 ]
}
