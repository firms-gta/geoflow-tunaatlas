# =============================================================================
# env.example: every setting of the Global Tuna Atlas stack and workflow
#
#   cp env.example .env      # then edit .env; .env is never committed (*.env
#                            # is git-ignored) nor copied into the images
#
# One file for everything: docker compose reads .env, the workflow containers
# receive it (env_file), and the geoflow configurations load it
# (config/geoflow/*.json, "environment": {"file": ".env"}).
# The values below are those of the local stack started by compose.yml.
# Keep the values plain (no ${...} interpolation): R reads this file too.
# =============================================================================

# --- Database (the PostGIS container of the stack) ----------------------------
DB_DRV=PostgreSQL
# Inside the stack the database host is the "postgres" service; from R on the
# host, use localhost and GTA_PG_PORT instead.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gta
DB_USER=gta
DB_PASSWORD=gta
# Read-only account (Shiny application and read access)
DB_USER_READONLY=gta_reader
DB_PASSWORD_READONLY=gta_reader
# Load the datasets into the database
GTA_DB_UPLOAD=true

# --- GeoServer (must match the GeoServer container: admin / geoserver) --------
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_PUBLIC_URL=http://localhost:18080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
GEOSERVER_WORKSPACE=tunaatlas
GEOSERVER_STORE=tunaatlas

# --- GeoNetwork (must match the GeoNetwork container: admin / admin) ----------
GEONETWORK_URL=http://geonetwork:8080/geonetwork
GEONETWORK_USER=admin
GEONETWORK_PASSWORD=admin
GEONETWORK_VERSION=4.4

# --- Zenodo (publication of the datasets by the "services" step) --------------
# TRUE publishes. A deposit on zenodo.org (not sandbox.zenodo.org) creates a
# permanent DOI: keep the sandbox until a real publication.
RUN_ZENODO_T_F=FALSE
ZENODO_URL=https://sandbox.zenodo.org/api
ZENODO_TOKEN=

# --- Notifications (optional, config/geoflow/db_global_datasets_catch.json)
GMAIL_USER=
GMAIL_TOKEN=

# --- Not here: the run options --------------------------------------------------
# GTA_STEPS, GTA_DATA_SOURCE, GTA_DATA_PATH, GTA_SUMMARISE_INVALID_RAW,
# GTA_BOOTSTRAP_RESTORE_RENV... are set for each run by docker/*.sh and
# compose.yml. Do not add them to .env: the launcher loads .env over the
# environment of the container, so a value here would replace theirs.

# --- Stack (docker compose) ---------------------------------------------------------
# Images. A new tag is a new download (~4.5 GB for the workflow, ~6 GB for RStudio).
GTA_IMAGE=ghcr.io/firms-gta/gta-workflow:latest
GTA_RSTUDIO_IMAGE=ghcr.io/firms-gta/gta-workflow:sha-af1c837-dev-rstudio
SHINY_TAG=latest
# Raw data folder mounted as data/GTA_2026 by the workflow and RStudio services
# (docker/run_workflow.sh uses tests/sample_data unless GTA_DATA_DIR is set
# when it is called)
GTA_DATA_DIR=./runtime/extracted/all_raw_data_GTA
# Host ports (127.0.0.1 only)
GTA_PG_PORT=15430
GTA_GEOSERVER_PORT=18080
GTA_GEONETWORK_PORT=18081
GTA_RSTUDIO_PORT=18787
GTA_SHINY_PORT=13838
# RStudio Server login: rstudio / RSTUDIO_PASSWORD
RSTUDIO_PASSWORD=test
# Elasticsearch memory (GeoNetwork index); "-Xms512m -Xmx512m" on small machines
ES_JAVA_OPTS="-Xms1g -Xmx1g"
# true: internal stack network, no internet access (checks that a run only
# needs the images and the data)
GTA_OFFLINE=false
